{
  "name": "pramaan-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "install:frontend": "npm --prefix frontend install --legacy-peer-deps",
    "install:backend": "pip install -r backend/requirements.txt",
    "backend": "python -m uvicorn main:app --app-dir backend --reload --port 8000"
  }
}

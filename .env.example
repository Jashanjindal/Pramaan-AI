# PramaanAI Configuration Environment Variables
PROJECT_NAME="PramaanAI API"
VERSION="1.0.0"
SECRET_KEY="super-secret-pramaan-ai-security-hash-key-2026"

# MongoDB Atlas Connection URI
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pramaan_db?retryWrites=true&w=majority"
DATABASE_NAME="pramaan_db"

# Optional: Live LLM API Keys (Google Gemini API / OpenAI API)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Frontend Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000"
